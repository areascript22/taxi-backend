# Copia este archivo a `.env` (que NO se versiona) y completa los valores.
# compose.yaml lo lee automáticamente.

# Contraseña de la base de datos. Obligatoria en el servidor: una larga y al
# azar (por ejemplo: openssl rand -base64 24). En desarrollo se puede omitir
# (compose.dev.yaml usa "taxiapp_dev").
POSTGRES_PASSWORD=

# Panel web de la base (pgAdmin, perfil "tools"). Obligatorios SOLO si lo vas a
# levantar en el servidor. El correo debe ser válido (pgAdmin rechaza dominios
# como .local o .test); la contraseña, larga y distinta de la de la base.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Puerto local del panel (solo 127.0.0.1).
# PGADMIN_PORT=5050

# Quién hace de proxy delante de la app, para ops/deploy.sh. En el droplet se
# omite (Caddy, por defecto). En staging: DEPLOY_PROXY=tunnel (Cloudflare Tunnel).
# DEPLOY_PROXY=tunnel

# Token del túnel de Cloudflare (SOLO staging, perfil "tunnel" de compose). Se
# copia desde el panel de Cloudflare al crear el túnel. Es un secreto.
CLOUDFLARE_TUNNEL_TOKEN=

# Perfil de Spring: "dev" apunta al proyecto de Firebase de desarrollo;
# "staging" es la VM de pruebas; "prod" es el droplet.
SPRING_PROFILES_ACTIVE=dev

# Credencial de la cuenta de servicio de Firebase (se monta de solo lectura).
# En el servidor: chown 10001:10001 y chmod 400 (el contenedor corre como uid 10001).
FIREBASE_CREDENTIALS_FILE=./secrets/taxigo-dev-firebase-adminsdk.json

# La cuenta dueña del proyecto (ver ARCHITECTURE.md). Opcionales.
TAXIAPP_ADMIN_FOUNDER_UID=
TAXIAPP_ADMIN_FOUNDER_EMAIL=

# Imagen del servidor. Por defecto se construye localmente (taxiapp:local). En
# el droplet NO se edita a mano: ops/deploy.sh la reescribe en cada despliegue
# (ghcr.io/areascript22/taxi-backend:<sha>).
# TAXIAPP_IMAGE=taxiapp:local
